<%-include('partials/header')%>
<section class="hero">
  <h1 class="greeting">Welcome to Aquarium World</h1>
  <p class="tagline">Dive in and explore amazing marine life from sunny coral reefs to the deep ocean! Enjoy fun hands-on exhibits, meet incredible creatures, and discover how to protect our waters together.</p>

  <div class="opening-times">
    <h2>Opening times</h2>
    <p>Open every day, <time datetime="09:00">9am</time> – <time datetime="18:00">6pm</time></p>
  </div>
</section>


<ul class="highlights" role="list">
  <li><span class="icon" aria-hidden="true">👨‍👩‍👧</span> Family friendly</li>
  <li><span class="icon" aria-hidden="true">♿</span> Step-free access</li>
  <li><span class="icon" aria-hidden="true">☕</span> Café on site</li>
</ul>

<section class="zones">
  <h2 class="zones-title">Explore our zones</h2>
  <div class="zone-grid">
    <% zones.forEach(zone => { %>
      <div class="zone-row">
        <article class="zone-card">
          <h3><%= zone.name %></h3>
          <p><%= zone.description %></p>
          <a class="button" href="/zone/<%= zone.slug %>">Explore <%= zone.name %></a>
        </article>
        <img src="/images/<%= zone.slug %>.jpg" alt="<%= zone.name %> zone">
      </div>
    <% }) %>
  </div>
</section>

<section class="cafe">
  <h2 class="zones-title">Our café</h2>
  <div class="zone-row">
    <article class="zone-card">
      <h3>Reef Café</h3>
      <p>Take a break with hot drinks, fresh snacks and a kids' menu, with views of our coral reef tank. Open 9am – 5:30pm.</p>
    </article>
    <img src="/images/cafe.jpg" alt="Aquarium café seating area">
  </div>
</section>

<section class="tickets" id="tickets"></section>

<%-include('partials/footer')%>