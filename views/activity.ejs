<%-include('partials/header')%>
    <section class="kids-activity">

        <h1>Rockpool Explorer</h1>
        <p>Lift the rocks to find the creatures hiding underneath!</p>

        <div class="rockpool">
            <div class="rock-spot">
                <button type="button" class="rock" aria-label="Lift a rock">🪨</button>
                <div class="creature" hidden>
                    <h2>Shore crab</h2>
                    <p>Crabs walk sideways and can grow back a lost claw!</p>
                    <img src="/images/shore-crab.jpg" alt="A shore crab hiding under a rock" width="300" height="200">
                </div>
            </div>

            <div class="rock-spot">
                <button type="button" class="rock" aria-label="Lift a rock">🪨</button>
                <div class="creature" hidden>
                    <h2>Starfish</h2>
                    <p>Starfish have no brain, but they can see with eyes at the end of each arm!</p>
                    <img src="/images/starfish.jpg" alt="A starfish hiding under a rock" width="300" height="200">
                </div>
            </div>

            <div class="rock-spot">
                <button type="button" class="rock" aria-label="Lift a rock">🪨</button>
                <div class="creature" hidden>
                    <h2>Sea anemone</h2>
                    <p>Anemones look like flowers, but they're animals that catch food with sticky tentacles.</p>
                    <img src="/images/sea-anemone.jpg" alt="A sea anemone hiding under a rock" width="300" height="200">
                </div>
            </div>

            <div class="rock-spot">
                <button type="button" class="rock" aria-label="Lift a rock">🪨</button>
                <div class="creature" hidden>
                    <h2>Prawn</h2>
                    <p>Prawns clean other animals by nibbling off tiny bits of food.</p>
                    <img src="/images/prawn.jpg" alt="A prawn hiding under a rock" width="300" height="200">
                </div>
            </div>

            <div class="rock-spot">
                <button type="button" class="rock" aria-label="Lift a rock">🪨</button>
                <div class="creature" hidden>
                    <h2>Limpet</h2>
                    <p>Limpets clamp onto rocks so tightly that waves can't wash them away.</p>
                    <img src="/images/limpet.jpg" alt="A limpet hiding under a rock" width="300" height="200">
                </div>
            </div>

            <div class="rock-spot">
                <button type="button" class="rock" aria-label="Lift a rock">🪨</button>
                <div class="creature" hidden>
                    <h2>Blenny</h2>
                    <p>Blennies can wriggle out of the water and wait on rocks for the tide to come back.</p>
                    <img src="/images/blenny.jpg" alt="A blenny hiding under a rock" width="300" height="200">
                </div>
            </div>
        </div>

        <p id="found-count" role="status">You found 0 of 6 creatures.</p>

    </section>

    <%-include('partials/footer')%>